# === LLM Providers ===
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# === Data Sources ===
SEMANTIC_SCHOLAR_API_KEY=
# Optional GitHub token raises the public repository search quota. Only public
# repositories are queried, even when a token with broader access is used.
GITHUB_TOKEN=

# === Memory & Storage ===
MEM0_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy shared-secret JWT signing only. New Supabase projects sign JWTs
# asymmetrically (ES256) and are verified via the JWKS endpoint derived from
# SUPABASE_URL; this secret is only used as a fallback for legacy HS256.
SUPABASE_JWT_SECRET=

# === App ===
# One canonical frontend URL; also sent as HTTP-Referer to OpenRouter.
APP_URL=http://localhost:3000
# Exact comma-separated browser origins; defaults to APP_URL when empty.
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Required in production for shared run state, rate limits, budgets and leases.
# Development may use in-memory state when unset; production fails closed.
REDIS_URL=

# === Scheduler ===
# Authenticates POST /api/internal/ingest (Fly scheduled machine / GH Actions cron)
ADMIN_API_KEY=

# === Cost guardrails ===
# Global model-provider gate. Keep false during staging; when true, chat still
# requires OpenRouter, positive daily/monthly caps, and a working spend ledger.
LLM_ENABLED=false
# Maximum number of LLM summarisation calls per search run; the rest of the
# papers get an abstract-preview fallback with no LLM call.
MAX_SUMMARIES_PER_RUN=20
MAX_SEARCHES_PER_DAY_PER_USER=100
# Both caps are integer USD micros per billing subject and fail closed at zero.
# Example: 1000000 is $1.00 for the UTC day/month respectively.
LLM_DAILY_SPEND_CAP_USD_MICROS=0
LLM_MONTHLY_SPEND_CAP_USD_MICROS=0
# Set true only after a billing limit is configured in the Mem0 provider account.
MEM0_PROVIDER_SPEND_LIMIT_CONFIRMED=false
# Provisional cross-paper synthesis is disabled until its quality gate is met.
RESEARCH_SYNTHESIS_ENABLED=false
# Public page evidence for arXiv is opt-in and only serves exact CC BY 4.0 / CC0 1.0 versions.
PUBLIC_PAPER_EVIDENCE_ENABLED=false
# Durable plan execution stays off pending staging/quality gates; preview remains available.
# When enabled: 10 executions/user/day, 5 requests/IP/minute; LLM_DAILY_SPEND_CAP_USD_MICROS and LLM_MONTHLY_SPEND_CAP_USD_MICROS also gate model usage.
RESEARCH_PLAN_EXECUTION_ENABLED=false

# Optional Resend delivery for consented watchlist digests. Keep disabled until
# migration 0020 and provider/webhook behavior pass staging verification. No
# message is sent unless the flag and all required Resend settings are present.
NOTIFICATIONS_EMAIL_ENABLED=false
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
# HMAC key for recipient hashes and unsubscribe token generation. Keep prior
# recipient-hash keys comma-separated during rotations to preserve old consent
# and suppression matches.
NOTIFICATIONS_UNSUBSCRIBE_SECRET=
NOTIFICATIONS_UNSUBSCRIBE_SECRET_PREVIOUS=

# === Frontend public vars (build-time; also in frontend/.env.local.example) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === Optional infrastructure ===
# Postgres checkpointer for LangGraph (required in production; dev can omit)
DATABASE_URL=
# Enforced before LangGraph imports; keep strict msgpack checkpoint decoding on.
LANGGRAPH_STRICT_MSGPACK=true
# Local-only OCR for scanned pages in project PDF uploads (disabled by default).
# Docker includes Tesseract English data; OCR is capped at 5 pages/upload,
# 8M rendered pixels/page, 6 seconds/page, and 20 seconds total.
OCR_ENABLED=false
# Paper-code sandbox (OFF by default; requires reviewed Docker runner)
SANDBOX_ENABLED=false

# === Observability (optional) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_ENV=development
