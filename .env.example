# === LLM Providers ===
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=

# === Data Sources ===
FIRECRAWL_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# === Memory & Storage ===
MEM0_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy shared-secret JWT signing only. New Supabase projects sign JWTs
# asymmetrically (ES256) and are verified via the JWKS endpoint derived from
# SUPABASE_URL; this secret is only used as a fallback for legacy HS256.
SUPABASE_JWT_SECRET=

# === App ===
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Required for multi-instance deployments: shared run state AND global rate
# limiting (slowapi). Falls back to in-memory stores when unset.
REDIS_URL=

# === Scheduler ===
# Authenticates POST /api/internal/ingest (Fly scheduled machine / GH Actions cron)
ADMIN_API_KEY=

# === Cost guardrails ===
# Maximum number of LLM summarisation calls per search run; the rest of the
# papers get an abstract-preview fallback with no LLM call.
MAX_SUMMARIES_PER_RUN=20

# === Observability (optional) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_ENV=development