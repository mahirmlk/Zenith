# Backend env — canonical full list is the repo-root .env.example.
# Copy the root .env.example to .env in this directory (Docker WORKDIR)
# or to the repo root when running from there. config.py reads .env
# relative to the current working directory.
OPENROUTER_API_KEY=
GITHUB_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
APP_URL=http://localhost:3000
REDIS_URL=
ADMIN_API_KEY=
MAX_SUMMARIES_PER_RUN=20
MAX_SEARCHES_PER_DAY_PER_USER=100
PUBLIC_PAPER_EVIDENCE_ENABLED=false
LLM_DAILY_SPEND_CAP_USD_MICROS=0
LLM_MONTHLY_SPEND_CAP_USD_MICROS=0
MEM0_PROVIDER_SPEND_LIMIT_CONFIRMED=false
SANDBOX_ENABLED=false
DATABASE_URL=
APP_ENV=development
